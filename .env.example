# Canonical origin — used for absolute OG image URLs, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Contact form delivery (https://resend.com).
# Without RESEND_API_KEY the form still validates and succeeds, logging the
# message to the server console instead of sending it.
RESEND_API_KEY=
CONTACT_TO_EMAIL=you@your-domain.com
# Must be a domain you have verified with Resend.
CONTACT_FROM_EMAIL=portfolio@your-domain.com
